<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  Options -MultiViews
  DirectoryIndex index.html

  # Jangan arahkan endpoint API ke React.
  RewriteRule ^api(?:/|$) - [L]

  # Biarkan file asset dan folder nyata dilayani langsung.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Semua route React Router diarahkan ke entry point aplikasi.
  RewriteRule ^ index.html [L]
</IfModule>
